# Copy to .env and fill in. Never commit real values (hard rule 14).
# Every variable here is declared in apps/api/src/lib/env.ts — that file is the
# authority, and it crashes at boot if something is missing or malformed.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Runtime uses the pooled connection; migrations and pg-boss need the direct one.
DATABASE_URL=postgresql://agapay:agapay@localhost:5432/agapay?schema=public
DIRECT_URL=postgresql://agapay:agapay@localhost:5432/agapay?schema=public

# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-32-plus-character-random-string

# Cookie domain for the refresh token. Leave empty locally so it stays host-only.
# In production set it to the shared parent domain (e.g. .agapay.org) when the web
# app and API are served from different subdomains.
COOKIE_DOMAIN=

# Allowed CORS origin and base for links in emails. Must be the web app's origin.
WEB_ORIGIN=http://localhost:5173

# Local inventory-photo storage (relative to apps/api). Ephemeral production
# disks need a persistent volume or object storage instead.
UPLOAD_DIR=uploads
UPLOAD_MAX_IMAGE_MB=5

# resend | smtp | console. "console" logs sends instead of delivering them.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Agapay <no-reply@example.com>

# Gmail SMTP. Needs a Google app password, not the account password:
# https://myaccount.google.com/apppasswords (2-Step Verification required).
# 587 = STARTTLS, 465 = implicit TLS (SMTP_SECURE=true).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=youraddress@gmail.com
# SMTP_PASS=your-16-char-app-password

# Resend free tier is 100 emails/day, so this stays below it with headroom.
# env.ts rejects a value above 100.
EMAIL_DAILY_LIMIT=90

# Gmail throttles per hour as well as per day. Rolled hourly, not per clock hour.
EMAIL_HOURLY_LIMIT=60

# Bot protection for the public request form. When unset, the API accepts
# submissions with rate limits only and logs a warning at startup.
# TURNSTILE_SECRET=replace-me
# Not yet consumed — declare them in env.ts when their module lands.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_CALENDAR_ID=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# CHAT_USER_DAILY_LIMIT=
# CHAT_GLOBAL_DAILY_LIMIT=

# Bootstrap admin, created by `npm run db:seed` when both are set (DB-27).
# Password goes through the same policy as a user-registered one. Production
# seed contains only reference data and this account.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-me-12-plus-chars
SEED_DEMO=false

# Demo staff account for clicking through the staff side. Created by
# `npm run db:seed` only when SEED_DEMO=true and both are set. Leave unset in
# production so no demo credentials exist there.
# SEED_STAFF_EMAIL=staff@example.com
# SEED_STAFF_PASSWORD=replace-me-12-plus-chars